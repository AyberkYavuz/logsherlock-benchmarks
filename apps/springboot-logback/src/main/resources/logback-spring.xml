<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Runtime log format selection.

            LOG_FORMAT=text   plaintext pattern layout (default)
            LOG_FORMAT=json   one JSON object per log record

        The value is read from the JVM system property -DLOG_FORMAT=... or, if
        that is absent, from the LOG_FORMAT environment variable, so switching
        the format requires no source change and no rebuild. Both console
        definitions emit the same vocabulary with the same values; only the
        serialization differs.
    -->
    <property name="benchmarkLogFormat" value="${LOG_FORMAT:-text}"/>

    <include resource="logback/console-appender-${benchmarkLogFormat}.xml"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
